// 1. Mapeamento do DOM: Seleciona os elementos HTML pelos seus IDs para manipulá-los
const formulario = document.getElementById('meuFormulario');
const progrmacao = document.getElementById('progrmacao');
const btnVerificar = document.getElementById('btnVerificar');
const tempo = document.getElementById('tempo');

// 2. Função de Validação Condicional
function verificarResposta() {
  // Trata o texto digitado pelo usuário: converte para minúsculas e remove espaços das pontas
  const resposta = progrmacao.value.toLowerCase().trim();
  
  // Condição: Se a resposta for "pyton" ou "python", exibe o campo extra de tempo
  if (resposta === 'pyton' || resposta === 'python') {
    tempo.style.display = 'block'; // Torna a div visível na tela
  } else {
    tempo.style.display = 'none';  // Esconde a div caso o valor não seja correspondente
  }
}

// 3. Ouvinte de Evento: Executa a validação quando o usuário clica no botão "Avançar"
btnVerificar.addEventListener('click', verificarResposta);

// 4. Ouvinte de Evento de Teclado
progrmacao.addEventListener('keydown', function(evento) {
  // Trata a tecla Enter para evitar que o formulário seja enviado acidentalmente antes da hora
  if (evento.key === 'Enter') {
    evento.preventDefault(); // Cancela o comportamento padrão da tecla Enter no formulário
    verificarResposta();    // Executa a checagem da pergunta 11
  }
});

// 5. Interceptador de Envio
formulario.addEventListener('submit', function(evento) {
  // Reservado para validações gerais antes da submissão final via API
});